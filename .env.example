# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nihongo_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Optional: Audio CDN / Object Storage (if not hosted locally)
NEXT_PUBLIC_AUDIO_BASE_URL="/audio"

# Supabase Storage (for Admin Audio Uploads)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_AUDIO_BUCKET="audio"

# ElevenLabs TTS (Optional: manual on-demand generation in Admin Portal)
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Feature Flags
isRegisterSensei=false